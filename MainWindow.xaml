<Window x:Class="LauncherC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperture Science Development Center" 
        Height="720" Width="1080"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontFamilyMain}"
        BorderBrush="{DynamicResource BrushWindowBorder}"
        BorderThickness="2"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <!-- Dynamic Themed Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBtnNormalBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnNormalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource CornerRadiusButton}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnNormalHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushConsoleBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dynamic Play Button Style -->
        <Style x:Key="PlayBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushPlayBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushPlayBtnText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushPlayBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource CornerRadiusButton}">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF9A00" BlurRadius="14" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnNormalBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress Bar Style -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource BrushConsoleBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <Grid x:Name="TemplateRoot">
                                <Rectangle x:Name="PART_Track"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Master Container -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <!-- Top Chrome & Navigation -->
                <RowDefinition Height="Auto"/>
                <!-- Main Content Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP HEADER BAR ================= -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <!-- Left: Logo & Project Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushBtnNormalBg}" BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusButton}" 
                            Width="44" Height="44" Margin="0,0,12,0" Padding="4">
                        <Image Source="Assets/icon.ico" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="APERTURE SCIENCE" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <Border Background="{DynamicResource BrushAccent}" CornerRadius="{DynamicResource CornerRadiusButton}" Padding="6,2" Margin="10,0,0,0">
                                <TextBlock x:Name="LblProjectBadge" Text="ПРОЕКТ: OBSHAGA" Foreground="{DynamicResource BrushAccentText}" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Minecraft 1.21.1 NeoForge • C# v2.0.0 • " FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="TxtThemeBadge" Text="MODERN 2.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextAccent}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Controls & Window Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Theme Toggle Button -->
                    <Button x:Name="BtnThemeToggle" Content="🎨 ТЕМА: MODERN" Margin="0,0,8,0" 
                            Style="{StaticResource ModernBtn}" Padding="10,5" FontSize="12"
                            Click="BtnThemeToggle_Click"/>

                    <!-- Discord Quick Button -->
                    <Button x:Name="BtnDiscord" Content="💬 Discord" Margin="0,0,8,0" 
                            Background="#5865F2" Foreground="White" BorderThickness="0" 
                            Padding="10,5" Cursor="Hand" FontWeight="SemiBold" FontSize="12"
                            Style="{StaticResource ModernBtn}" Click="BtnDiscord_Click"/>

                    <!-- Language Toggle Button -->
                    <Button x:Name="BtnLang" Content="🌐 RU" Margin="0,0,8,0" 
                            Style="{StaticResource ModernBtn}" Padding="10,5" FontSize="12"
                            Click="BtnLang_Click"/>

                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings" Content="⚙ Настройки" Margin="0,0,12,0" 
                            Style="{StaticResource ModernBtn}" Padding="10,5" FontSize="12"
                            Click="BtnSettings_Click"/>

                    <!-- Window Minimize -->
                    <Button Content="─" Width="32" Height="32" Margin="0,0,4,0" 
                            Background="Transparent" Foreground="{DynamicResource BrushTextSecondary}" BorderThickness="0" 
                            FontSize="12" Cursor="Hand" Click="MinimizeBtn_Click"/>

                    <!-- Window Close -->
                    <Button Content="✕" Width="32" Height="32" 
                            Background="Transparent" Foreground="{DynamicResource BrushTextSecondary}" BorderThickness="0" 
                            FontSize="14" Cursor="Hand" Click="CloseBtn_Click"/>
                </StackPanel>
            </DockPanel>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left: Terminal Console (Log) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: Profile, News & Launch Panel -->
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Terminal Console Card -->
                <Border Grid.Column="0" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" 
                        BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Console Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- Console Log Box -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Status Indicator Dot -->
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#22C55E" BlurRadius="6" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="LblTerminalTitle" Text="ТЕРМИНАЛ ПРОТОКОЛА" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="LblStatusText" Text="[ГОТОВ К ЗАПУСКУ]" Margin="8,0,0,0" Foreground="#22C55E" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="ChkAutoScroll" Content="Автоскролл" IsChecked="True" 
                                          Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button x:Name="BtnClearLog" Content="Очистить" Style="{StaticResource ModernBtn}" 
                                        Padding="8,3" FontSize="11" Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Console Monospace TextBox -->
                        <TextBox x:Name="TxtConsoleLog" Grid.Row="1"
                                 Background="{DynamicResource BrushConsoleBg}" Foreground="{DynamicResource BrushTextPrimary}" 
                                 BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                 FontFamily="{DynamicResource FontFamilyMono}" FontSize="12" 
                                 IsReadOnly="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Padding="10" SelectionBrush="{DynamicResource BrushAccent}"/>
                    </Grid>
                </Border>

                <!-- RIGHT: Retro Banner, Profile, News & Launch Section -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!-- 0. Dedicated Retro 1973 Logo Banner (Prominent size in Retro theme!) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1. Player Profile Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2. News / Changelog Card -->
                        <RowDefinition Height="*"/>
                        <!-- 3. Launch Action Card -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0. БОЛЬШОЙ РЕТРО-ЛОГОТИП 1973 ГОДА (Выделено много места, не сжато!) -->
                    <Border Grid.Row="0" x:Name="BorderRetroLogo" 
                            Background="{DynamicResource BrushCardBg}" 
                            BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" 
                            CornerRadius="{DynamicResource CornerRadiusCard}" 
                            Padding="14,10" 
                            Margin="0,0,0,12"
                            Visibility="{DynamicResource RetroBannerVisibility}"
                            HorizontalAlignment="Stretch">
                        <Grid HorizontalAlignment="Center">
                            <!-- Подложка и изображение логотипа 1973 года с высоким разрешением -->
                            <Image Source="Assets/logo_1973.png" 
                                   MaxHeight="115" 
                                   MaxWidth="340" 
                                   Stretch="Uniform" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>

                    <!-- 1. PLAYER PROFILE CARD -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar Head Preview -->
                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="{DynamicResource CornerRadiusButton}" 
                                    BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" 
                                    Background="{DynamicResource BrushConsoleBg}" Margin="0,0,12,0" ClipToBounds="True">
                                <Image x:Name="ImgAvatar" Source="Assets/icon.ico" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>

                            <!-- Nickname & Mode Toggle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="LblNickname" Text="Никнейм:" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                
                                <TextBox x:Name="TxtNickname" Height="32" 
                                         Background="{DynamicResource BrushConsoleBg}" Foreground="{DynamicResource BrushTextPrimary}" 
                                         BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                         FontFamily="{DynamicResource FontFamilyMono}" FontSize="13" FontWeight="Bold" 
                                         Padding="8,5" VerticalContentAlignment="Center" 
                                         LostFocus="TxtNickname_LostFocus" KeyDown="TxtNickname_KeyDown"/>

                                <!-- Auth Mode Toggle Pill Button -->
                                <Button x:Name="BtnAuthToggle" Margin="0,6,0,0" Padding="8,4" 
                                        HorizontalAlignment="Left" Style="{StaticResource ModernBtn}" 
                                        Click="BtnAuthToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtAuthIcon" Text="🔶" Margin="0,0,4,0"/>
                                        <TextBlock x:Name="TxtAuthMode" Text="Сотрудник Aperture (ely.by)" FontSize="11" Foreground="{DynamicResource BrushTextAccent}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. NEWS & CHANGELOG CARD -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tabs: Сборка / Лаунчер -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnTabPack" Content="📦 СБОРКА" Style="{StaticResource ModernBtn}" 
                                            Background="{DynamicResource BrushAccent}" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,6,0" 
                                            Padding="12,5" FontSize="11" FontWeight="Bold" Click="BtnTabPack_Click"/>
                                    
                                    <Button x:Name="BtnTabLauncher" Content="🚀 ЛАУНЧЕР" Style="{StaticResource ModernBtn}" 
                                            Padding="12,5" FontSize="11" Click="BtnTabLauncher_Click"/>
                                </StackPanel>
                                
                                <Button x:Name="BtnRefreshNews" DockPanel.Dock="Right" Content="↻" Width="26" Height="26" 
                                        Style="{StaticResource ModernBtn}" Padding="0" FontSize="13" 
                                        Click="BtnRefreshNews_Click"/>
                            </DockPanel>

                            <!-- Changelog Text Display -->
                            <TextBox x:Name="TxtNews" Grid.Row="1" 
                                     Background="{DynamicResource BrushConsoleBg}" Foreground="{DynamicResource BrushTextPrimary}" 
                                     BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                     FontFamily="{DynamicResource FontFamilyMono}" FontSize="12" IsReadOnly="True" 
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                     Padding="10"/>
                        </Grid>
                    </Border>

                    <!-- 3. LAUNCH ACTION PANEL -->
                    <Border Grid.Row="3" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" 
                            BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14">
                        <StackPanel>
                            <!-- Server & Active Directory Info -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Сервер: obshaga.my-craft.cc:37015" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                                <TextBlock x:Name="TxtRamHint" Text="4096 MB" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextAccent}" FontSize="11" FontWeight="Bold"/>
                            </DockPanel>

                            <!-- Animated Progress Bar -->
                            <ProgressBar x:Name="LaunchProgressBar" Style="{StaticResource ModernProgressBar}" 
                                         Visibility="Collapsed" Margin="0,0,0,10"/>

                            <!-- Big Glowing Play Button -->
                            <Button x:Name="BtnPlay" Content="ИГРАТЬ" Height="52" 
                                    Style="{StaticResource PlayBtnStyle}" 
                                    Click="BtnPlay_Click"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </Grid>

        <!-- CRT SCANLINES OVERLAY (Visible in Retro Theme) -->
        <Rectangle Fill="{StaticResource ScanlinesBrush}" 
                   Visibility="{DynamicResource ScanlinesVisibility}" 
                   IsHitTestVisible="False" 
                   Opacity="0.25"/>
    </Grid>
</Window>
