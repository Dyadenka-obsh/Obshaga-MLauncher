<Window x:Class="LauncherC.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Aperture" 
        Height="660" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontFamilyMain}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderBrush="{DynamicResource BrushWindowBorder}"
        BorderThickness="2"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Modern Scrollbar Style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource BrushConsoleBg}"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Dynamic Themed Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBtnNormalBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBtnNormalBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontFamilyMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource CornerRadiusButton}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBtnNormalHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushConsoleBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentHover}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource CornerRadiusButton}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#2D1518"/>
            <Setter Property="Foreground" Value="#FF6B7A"/>
            <Setter Property="BorderBrush" Value="#542329"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource CornerRadiusButton}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#451A20"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF6B7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Discord Button Style -->
        <Style x:Key="DiscordBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#7289DA"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Settings Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource BrushAccent}" Width="8" Height="20" CornerRadius="{DynamicResource CornerRadiusButton}" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtTitle" Text="Настройки Aperture" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="✕" Width="30" Height="30" 
                    Background="Transparent" Foreground="{DynamicResource BrushTextSecondary}" BorderThickness="0" 
                    FontSize="14" Cursor="Hand" Click="CloseBtn_Click"/>
        </DockPanel>

        <!-- Scrollable Settings Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,10">
            <StackPanel Margin="0,0,8,0">

                <!-- 1. ВЫБОР ТЕМЫ ОФОРМЛЕНИЯ -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="LblTheme" Text="Тема оформления:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,8"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnThemeModern" Grid.Column="0" Content="Современная 2.0" 
                                    Style="{StaticResource ModernBtn}" Margin="0,0,4,0" Height="36" 
                                    Click="BtnThemeModern_Click"/>

                            <Button x:Name="BtnThemeRetro" Grid.Column="1" Content="Ретро 1973 (v1.2)" 
                                    Style="{StaticResource ModernBtn}" Margin="4,0,0,0" Height="36" 
                                    Click="BtnThemeRetro_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. ВЫБОР ПАПКИ УСТАНОВКИ MINECRAFT -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="LblGameDir" Text="Папка установки Minecraft:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"/>
                        </DockPanel>
                        
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TxtMinecraftPath" Grid.Column="0" Height="34" 
                                     Background="{DynamicResource BrushConsoleBg}" Foreground="{DynamicResource BrushTextPrimary}" 
                                     BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                     Padding="8,6" VerticalContentAlignment="Center" 
                                     FontFamily="{DynamicResource FontFamilyMono}" FontSize="12"/>
                            
                            <Button x:Name="BtnBrowsePath" Grid.Column="1" Content="Обзор..." Margin="6,0,0,0" 
                                    Style="{StaticResource ModernBtn}" Height="34" Padding="12,4" 
                                    Click="BtnBrowsePath_Click"/>
                            
                            <Button x:Name="BtnDefaultPath" Grid.Column="2" Content="По умолчанию" Margin="6,0,0,0" 
                                    Style="{StaticResource ModernBtn}" Height="34" Padding="12,4" 
                                    Click="BtnDefaultPath_Click"/>
                        </Grid>
                        
                        <TextBlock x:Name="LblGameDirHint" Text="Все моды, конфигурации и файлы игры будут сохраняться в этой папке." 
                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. ВЫДЕЛЕНИЕ ОЗУ -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="LblRamAlloc" Text="Выделение ОЗУ (МБ):" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13"/>
                            <TextBlock x:Name="TxtRamValue" Text="4096 МБ (4.0 ГБ)" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextAccent}" FontWeight="Bold" FontSize="13"/>
                        </DockPanel>
                        
                        <Slider x:Name="SliderRam" Minimum="1024" Maximum="16384" SmallChange="512" LargeChange="1024" 
                                IsSnapToTickEnabled="True" TickFrequency="1024" Value="4096" Margin="0,4,0,6"
                                ValueChanged="SliderRam_ValueChanged"/>
                        
                        <TextBlock x:Name="LblMaxSafeRam" Text="(Безопасный максимум: 14336 МБ)" 
                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- 4. ПОЛЬЗОВАТЕЛЬСКАЯ JAVA (НЕОБЯЗАТЕЛЬНО) -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="LblCustomJava" Text="Пользовательская Java 21+ (необязательно):" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,6"/>
                        
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TxtCustomJava" Grid.Column="0" Height="34" 
                                     Background="{DynamicResource BrushConsoleBg}" Foreground="{DynamicResource BrushTextPrimary}" 
                                     BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" 
                                     Padding="8,6" VerticalContentAlignment="Center" 
                                     FontFamily="{DynamicResource FontFamilyMono}" FontSize="12"/>
                            
                            <Button x:Name="BtnBrowseJava" Grid.Column="1" Content="Выбрать..." Margin="6,0,0,0" 
                                    Style="{StaticResource ModernBtn}" Height="34" Padding="12,4" 
                                    Click="BtnBrowseJava_Click"/>
                        </Grid>
                        
                        <TextBlock Text="Оставьте пустым для автоматического использования проверенной Java 21." 
                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 5. БЫСТРЫЕ ДЕЙСТВИЯ И ПАПКИ -->
                <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusCard}" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Управление файлами и сообщество:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" Margin="0,0,0,10"/>
                        
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button x:Name="BtnOpenGameDir" Grid.Column="0" Content="📁 Папка игры" 
                                    Style="{StaticResource ModernBtn}" Margin="0,0,4,0" 
                                    Click="BtnOpenGameDir_Click"/>
                            
                            <Button x:Name="BtnOpenMods" Grid.Column="1" Content="📦 Папка с модами" 
                                    Style="{StaticResource ModernBtn}" Margin="4,0,0,0" 
                                    Click="BtnOpenMods_Click"/>
                        </Grid>
                        
                        <Button x:Name="BtnRepairBuild" Content="🛠 Починить сборку (Очистить моды)" 
                                Style="{StaticResource DangerBtn}" Margin="0,0,0,8" 
                                Click="BtnRepairBuild_Click"/>

                        <Button x:Name="BtnJoinDiscord" Content="💬 Наш Discord-сервер" 
                                Style="{StaticResource DiscordBtn}" 
                                Click="BtnJoinDiscord_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="v2.0.0 C# Edition" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11"/>
            </StackPanel>
            
            <Button x:Name="BtnSaveClose" DockPanel.Dock="Right" Content="Сохранить и закрыть" 
                    Style="{StaticResource AccentBtn}" Padding="20,10" 
                    Click="BtnSaveClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
