<Application x:Class="LauncherC.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LauncherC"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- CRT Scanlines Raster Brush for 1973 Retro Theme -->
        <DrawingBrush x:Key="ScanlinesBrush" TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,1,4"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#2A1A08">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,3,1,1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Application.Resources>
</Application>
